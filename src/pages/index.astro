---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';
import SectionList from '../components/SectionList.astro';
import ProjectList from '../components/ProjectList.astro';
import Social from '../components/Social.astro';

import { getCollection } from 'astro:content';

const cv = await getCollection('cv');
---

<PageLayout title="Tom Weglarz">
  <Hero
    title="Tom Weglarz"
    description="Buying my first business, projected acquisition July-September 2026, using a SBA 7(a) Loan. Please reach out if you own a business or would like o invest in local DFW businesses."
    role="Christ First"
    location="Dallas–Fort Worth, Texas"
    actions={[
      { label: 'View Blog', href: '/blog' },
      { label: 'Get Quote', href: '/contact' },
    ]}
  />

 

  <ProjectList heading="Projects" limit={4} viewAllHref="/projects" />

  <PostList heading="Blog" limit={3} viewAllHref="/blog" />

  {
    cv.map((section) =>
      section.data?.items ? (
        <SectionList heading={section.data.heading} items={section.data.items} />
      ) : null
    )
  }
</PageLayout>
